# --- Slack app credentials (create a NEW app at api.slack.com/apps) ---
# Socket Mode app-level token, scope: connections:write
SLACK_APP_TOKEN=xapp-...
# Bot user OAuth token, scopes: channels:history, chat:write, emoji:read
SLACK_BOT_TOKEN=xoxb-...

# --- Browser session, required because Slack has no bot API for emoji upload ---
# From a logged-in Slack web session: localStorage token / the `d` cookie
SLACK_USER_TOKEN=xoxc-...
SLACK_COOKIE=xoxd-...

# --- Behaviour ---
SLACK_SUBDOMAIN=hackclub
GHOSTIFY_CHANNEL=C0C343T6GLA
GHOSTIFY_PREFIX=ghost-
# Reaction added while a message is being processed
GHOSTIFY_LOADING_EMOJI=loading
# EMOJI_CACHE_TTL_MS=30000
# MAGICK_BIN=magick
# PORT=3000
